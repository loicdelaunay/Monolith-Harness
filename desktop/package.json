{
  "name": "monolith-harness-desktop",
  "version": "1.84.0",
  "private": true,
  "description": "Monolith Harness desktop host for macOS and Windows",
  "author": "Monolith Harness",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:service": "node --test tests/service.test.cjs",
    "build:service": "node scripts/publish-service.cjs",
    "pack:mac": "electron-builder --mac --dir",
    "dist:mac": "electron-builder --mac dmg zip",
    "pack:win": "electron-builder --win --dir"
  },
  "devDependencies": { "electron": "44.4.2", "electron-builder": "26.15.3" },
  "build": {
    "appId": "com.monolithharness.desktop",
    "productName": "Monolith Harness",
    "asar": true,
    "files": ["main.cjs", "preload.cjs", "browser.cjs", "application-capture.cjs", "policy.cjs", "ui/**", "package.json"],
    "directories": { "output": "dist" },
    "mac": {
      "icon": "ui/app.icns",
      "extraResources": [{ "from": "sidecar/mac-${arch}/MonolithHarness", "to": "service/MonolithHarness" }],
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "binaries": ["Contents/Resources/service/MonolithHarness"],
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "NSAppleEventsUsageDescription": "Monolith Harness uses desktop tools only after your approval.",
        "NSScreenCaptureUsageDescription": "Share screenshots with your AI provider only after approval."
      }
    },
    "win": { "icon": "ui/app.ico", "extraResources": [{ "from": "sidecar/win-${arch}/MonolithHarness.exe", "to": "service/MonolithHarness.exe" }], "target": "dir" },
    "linux": { "icon": "ui/logo.png" }
  }
}
