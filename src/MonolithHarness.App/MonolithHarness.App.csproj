<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>WinExe</OutputType><TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(MonolithHarnessDesktopOnly)' != 'true'">net10.0-desktop;net10.0-windows10.0.19041.0</TargetFrameworks>
    <UnoFeatures>SkiaRenderer;WebView</UnoFeatures>
    <UnoDisableWinAppRunSupport>true</UnoDisableWinAppRunSupport>
    <WinAppSdkVersion>1.8.251106002</WinAppSdkVersion>
    <ApplicationTitle>Monolith Harness</ApplicationTitle>
    <AssemblyTitle>Monolith Harness</AssemblyTitle>
    <Product>Monolith Harness</Product>
    <ApplicationId>com.monolithharness.app</ApplicationId>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationDisplayVersion>1.57.0</ApplicationDisplayVersion>
    <ApplicationVersion>85</ApplicationVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <UseMonoRuntime>false</UseMonoRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('windows10'))">
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion><UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../CHANGELOG.md" LogicalName="MonolithHarness.Changelog.md" />
    <EmbeddedResource Include="Assets/rich-text-editor.html" />
    <EmbeddedResource Include="Assets/benchmark-preview.html" />
    <EmbeddedResource Include="Assets/Markdown/*" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.40.0" />
    <ProjectReference Include="../MonolithHarness.Core/MonolithHarness.Core.csproj" GlobalPropertiesToRemove="TargetFrameworks" />
  </ItemGroup>
  <Import Project="../../build/PythonRuntime.targets" />
  <Import Project="../../build/MonolithLauncher.targets" />
  <ItemGroup><AssemblyMetadata Include="MonolithHarness.SingleFile" Value="$(PublishSingleFile)" /></ItemGroup>
  <Target Name="ExcludePublishedDebugSymbols" BeforeTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
