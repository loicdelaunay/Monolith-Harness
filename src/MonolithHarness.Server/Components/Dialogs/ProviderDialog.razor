@using System.Globalization
@using Vertex = MonolithHarness.Core.VertexAi
@inject UiContext Ui
@inject ProviderService Providers

<MudDialog>
    <DialogContent>
        <MudSelect T="string" Value="_type" ValueChanged="ProviderTypeChanged" Label="Type de fournisseur" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
            <MudSelectItem T="string" Value='@("openai")'>API compatible OpenAI</MudSelectItem>
            <MudSelectItem T="string" Value='@("vertex")'>Vertex AI · Google Cloud</MudSelectItem>
        </MudSelect>
        @if (_type == "vertex")
        {
            <MudSelect T="string" Value="_auth" ValueChanged="AuthenticationChanged" Label="Authentification Google Cloud" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                <MudSelectItem T="string" Value="@Vertex.Adc">Google Cloud ADC</MudSelectItem>
                <MudSelectItem T="string" Value="@Vertex.ApiKey">Clé API Google Cloud · projet</MudSelectItem>
                <MudSelectItem T="string" Value="@Vertex.Express">Clé API Google Cloud · Express</MudSelectItem>
            </MudSelect>
            @if (_auth != Vertex.Express)
            {
                <MudTextField Immediate="true" @bind-Value="_project" Label="Identifiant du projet Google Cloud" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <MudTextField Immediate="true" @bind-Value="_region" Label="Région" Placeholder="global" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            }
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                @(_auth == Vertex.Adc ? "ADC doit être configuré sur la machine du serveur. Les jetons sont renouvelés automatiquement."
                    : _auth == Vertex.Express ? "Clé Vertex AI Express : aucun ADC requis. Saisissez les modèles manuellement, Express ne propose pas de catalogue."
                    : "Clé Google Cloud autorisée pour Vertex AI et le projet, avec les droits IAM requis. Aucun ADC nécessaire.")
                L’éligibilité des crédits est définie par Google.
            </MudAlert>
        }
        <MudTextField Immediate="true" @bind-Value="_name" Label="Nom" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
        @if (_type != "vertex")
        {
            <MudTextField Immediate="true" @bind-Value="_url" Label="Adresse de l’API (compatible OpenAI)" Placeholder="https://api.openai.com/v1" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                          HelperText="Reste sur le serveur: jamais transmise aux clients." />
        }
        @if (_type != "vertex" || _auth != Vertex.Adc)
        {
            <MudTextField Immediate="true" @bind-Value="_secret" Label="@(Existing is { HasSecret: true } ? "Clé d’API (laisser vide pour conserver l’actuelle)" : "Clé d’API")" InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1" HelperText="Chiffrée sur le serveur; elle ne peut plus être relue ensuite." />
            @if (Existing is { HasSecret: true })
            {
                <MudCheckBox T="bool" @bind-Value="_clearSecret" Dense="true" Color="Color.Primary" Label="Supprimer la clé enregistrée" />
            }
        }
        <div class="d-flex flex-wrap gap-2 align-center mt-2">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.NetworkCheck" Disabled="@(_busy || ProbeUrl.Trim().Length == 0)" OnClick="Test">Tester la connexion</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ManageSearch" Disabled="@(_busy || ProbeUrl.Trim().Length == 0)" OnClick="Detect">Détecter les modèles</MudButton>
            @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Appel du provider en cours" /> }
        </div>
        @if (_probe != null)
        {
            <MudAlert Severity="@(_probe.Ok ? Severity.Success : Severity.Error)" Dense="true" Variant="Variant.Outlined" Class="mt-2">@_probe.Message</MudAlert>
        }
        <MudTextField Immediate="true" @bind-Value="_models" Label="Modèles proposés" ShrinkLabel="true" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mh-mono"
                      HelperText="Un modèle par ligne: identifiant ; contexte (jetons) ; images (oui/non). Exemple: gpt-4.1-mini ; 128000 ; oui" />
        <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Primary" Label="Provider activé" />
        <MudSwitch T="bool" @bind-Value="_local" Color="Color.Primary" Label="Utilisable aussi par les exécutions locales des clients (relais)" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Annuler</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">@(Existing == null ? "Ajouter" : "Enregistrer")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProviderView? Existing { get; set; }

    public sealed record Result(string Name, string BaseUrl, string? Secret, List<ProviderModel> Models, bool Enabled, bool AllowLocalUse);

    string _name = "", _url = "", _secret = "", _models = "";
    string _type = "openai", _project = "", _region = "global", _auth = Vertex.Adc;
    bool _enabled = true, _local, _clearSecret, _busy;
    ProviderProbe? _probe;

    protected override void OnInitialized()
    {
        if (Existing == null) return;
        _name = Existing.Name;
        _url = Existing.BaseUrl;
        _enabled = Existing.IsEnabled;
        _local = Existing.AllowLocalUse;
        if (Vertex.TryRead(Existing.BaseUrl, out var vertex) && (!Existing.HasSecret || vertex!.UsesApiKey))
        { _type = "vertex"; _project = vertex!.Project; _region = vertex.Location; _auth = vertex.Authentication; }
        _models = string.Join('\n', Existing.Models.Select(x => $"{x.Id} ; {x.ContextLimit} ; {(x.SupportsImages ? "oui" : "non")}"));
    }

    void ProviderTypeChanged(string value)
    {
        _type = value; _probe = null;
        if (value == "vertex" && _models.Length == 0) _models = "google/gemini-4-argon ; 256000 ; oui";
    }
    void AuthenticationChanged(string value) { _auth = value; _probe = null; }
    string ProbeUrl
    {
        get
        {
            if (_type != "vertex") return _url;
            try { return Vertex.Endpoint(_project, _region, _auth); }
            catch (ArgumentException) { return ""; }
        }
    }

    static List<ProviderModel> Parse(string text) => text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(line =>
    {
        var parts = line.Split(';', StringSplitOptions.TrimEntries);
        var context = parts.Length > 1 && int.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) ? value : 128000;
        var images = parts.Length > 2 && parts[2].ToLowerInvariant() is "oui" or "yes" or "true" or "1";
        return new ProviderModel(parts[0], context, images);
    }).ToList();

    // The typed key is used when there is one; otherwise the stored key of the provider being edited (never shown, never sent to the browser).
    string? ProbeSecret => _type == "vertex" && _auth == Vertex.Adc ? "" : _clearSecret ? "" : string.IsNullOrEmpty(_secret) ? (Existing == null ? "" : null) : _secret;

    async Task<ProviderProbe?> Probe()
    {
        _busy = true;
        try
        {
            _probe = await Ui.Try(user =>
            {
                if (!Ui.Can(user, Permissions.ProvidersManage)) throw ApiException.Forbidden("missing_permission");
                return Providers.ProbeAsync(ProbeUrl, ProbeSecret, Existing?.Id);
            });
            return _probe;
        }
        finally { _busy = false; }
    }

    Task Test() => Probe();

    /// <summary>Adds the models the provider publishes to the list; models already listed keep the values typed here.</summary>
    async Task Detect()
    {
        if (await Probe() is not { Ok: true, Models.Count: > 0 } probe) return;
        var known = Parse(_models).Select(x => x.Id).ToHashSet(StringComparer.Ordinal);
        var added = probe.Models.Where(x => !known.Contains(x.Id)).ToList();
        if (added.Count > 0)
            _models = string.Join('\n', new[] { _models.TrimEnd() }.Where(x => x.Length > 0).Concat(added.Select(x => $"{x.Id} ; {x.ContextLimit} ; {(x.SupportsImages ? "oui" : "non")}")));
        _probe = probe with
        {
            Message = _type == "vertex" ? probe.Message + $" {added.Count} ajouté(s) à la liste; vérifiez contexte et images."
                : added.Count == 0
                ? $"{probe.Models.Count} modèle(s) détecté(s) · tous figurent déjà dans la liste."
                : $"{probe.Models.Count} modèle(s) détecté(s) · {added.Count} ajouté(s) à la liste (vérifiez le contexte et les images avant d’enregistrer)."
        };
    }

    void Cancel() => MudDialog.Cancel();

    // null keeps the stored key, an empty string removes it.
    void Submit()
    {
        try
        {
            var url = _type == "vertex" ? Vertex.Endpoint(_project, _region, _auth) : _url;
            MudDialog.Close(DialogResult.Ok(new Result(_name, url, ProbeSecret, Parse(_models), _enabled, _local)));
        }
        catch (ArgumentException error) { _probe = new(false, 0, 0, error.Message, []); }
    }
}
