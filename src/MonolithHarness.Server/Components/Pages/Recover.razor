@page "/recover"
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Récupération · Monolith Harness Server</PageTitle>

<div class="mh-auth">
    <form class="mh-auth-card" method="post" action="/auth/recover">
        <AntiforgeryToken />
        <img src="logo-256.png" alt="" width="48" height="48" />
        <h1>Récupérer un compte</h1>
        <p>Saisissez le code à usage unique remis par un administrateur (valable une heure), puis choisissez un nouveau mot de passe.</p>
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="mh-error" role="alert">@Message</div>
        }
        <label for="email">Adresse e-mail</label>
        <input id="email" name="email" type="email" autocomplete="username" required autofocus />
        <label for="code">Code de récupération</label>
        <input id="code" name="code" type="text" autocomplete="one-time-code" required spellcheck="false" />
        <label for="password">Nouveau mot de passe</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
        <div class="mh-actions">
            <a href="/login">Retour à la connexion</a>
            <button class="mh-primary" type="submit">Changer le mot de passe</button>
        </div>
        <div class="mh-note">Sur un serveur sans administrateur disponible, la commande <span class="mh-mono">reset-password --email …</span> exécutée sur la machine émet un code.</div>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] string? Error { get; set; }
    [SupplyParameterFromQuery] int? Wait { get; set; }

    string Message => Error switch
    {
        "too_many_attempts" => $"Trop de tentatives. Réessayez dans {Wait ?? 30} secondes.",
        "weak_password" => "Mot de passe trop court: 8 caractères minimum.",
        _ => "Le code de récupération est invalide ou a expiré."
    };
}
